title           =  pull

; Run parameters
integrator      = md            ; leap-frog integrator
nsteps          = 2500000       ; 5000 ps ; 5 ns
dt              = 0.002         ; 2 fs
tinit                  =  0.0


; Output control
nstcomm                =  100
nstcalcenergy          =  100
nstxout-compressed     =  5000
compressed-x-precision =  1000
nstxout                =  0
nstvout                =  0
nstfout                =  0
nstlog                 =  0
nstenergy              =  5000

; Bond parameters
continuation	        = yes		; continuation
constraint_algorithm    = lincs	        ; holonomic constraints 
constraints	        = all-bonds	; all bonds (even heavy atom-H bonds) constrained
lincs_iter	        = 1		; accuracy of LINCS
lincs_order	        = 8		; also related to accuracy; lincs_order value of 8 works better than 4
;lincs-warnangle		= 90		; maximum angle that a bond can rotate before LINCS will complain

; Neighborsearching
cutoff-scheme       = Verlet
ns_type		    = grid		; search neighboring grid cells
nstlist		    = 10		; 20 fs, largely irrelevant with Verlet
rcoulomb	    = 1.0		; short-range electrostatic cutoff (in nm)
rvdw		    = 1.0		; short-range van der Waals cutoff (in nm)

; Electrostatics
coulombtype	    = PME	; Particle Mesh Ewald for long-range electrostatics
pme_order	    = 4		; cubic interpolation
fourierspacing	    = 0.16	; grid spacing for FFT

; Temperature coupling is on
tcoupl		= V-rescale	   ; modified Berendsen thermostat
tc-grps		= CB7_IFL SOL	   ; two coupling groups - more accurate
tau_t		= 0.1  0.1         ; time constant, in ps
ref_t		= 300  300         ; reference temperature, one for each group, in K

; Pressure coupling is on
pcoupl		        = berendsen		    ; Pressure coupling on in NPT
pcoupltype	        = semiisotropic	            ; This can be useful for membrane simulations
tau_p		        = 2.0   	            ; time constant, in ps
ref_p		        = 1.0 1.0		    ; reference pressure, in bar
compressibility         = 4.5e-5 4.5e-5 	    ; isothermal compressibility of water, bar^-1
refcoord-scaling        = all	 		    ; The reference coordinates are scaled with the scaling matrix of the pressure coupling

; Periodic boundary conditions
pbc		= xyz		    ; 3-D PBC

; Dispersion correction
DispCorr	= EnerPres	; account for cut-off vdW scheme

; Velocity generation
gen_vel		= no		; assign velocities from Maxwell distribution

; Energy monitoring 
; (ions - when present - should be added to the SOL group in the index file)
energygrps          =  CB7_IFL SOL

; Pull code
pull                    = yes
pull_ngroups            = 2
pull_ncoords            = 1
pull_group1_name        = Chain_A
pull_group2_name        = Chain_B
pull_coord1_type        = umbrella      ; harmonic biasing force
pull_coord1_geometry    = distance     ; distance in Lemkul
pull_coord1_groups      = 1 2
pull_coord1_dim         = Y Y Y
pull_coord1_rate        = 0.0           ; 0.01 nm per ps = 10 nm per ns
pull_coord1_k           = 3000          ; kJ mol^-1 nm^-2
pull_coord1_start       = no
pull-coord1-init        = XXX.XXX
;pull-coord1-vec         = 0.0 0.0 1.0
pull-nstxout            = 1000          ; every 2 ps
pull-nstfout            = 1000          ; every 2 ps



